# Серверные настройки
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# JWT настройки
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# База данных
DATABASE_URL=./data/kotex.db

# Файловое хранилище
STORAGE_PATH=./storage
MAX_FILE_SIZE=104857600
RAID_ENABLED=false
RAID_PATHS=

# WebRTC / Mediasoup
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=49999

# STUN/TURN серверы
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_SERVER=
TURN_USERNAME=
TURN_CREDENTIAL=

# Безопасность
CORS_ORIGIN=http://localhost:5173,http://localhost:3001
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Логирование
LOG_LEVEL=info
LOG_FILE=./logs/server.log

# ── Корпоративный контур (учётки из каталога организации) ──────────────
# Пусто — выключен, мессенджер работает как обычно.
ENT_DIRECTORY=ldap
ENT_LDAP_URL=ldaps://dc1.example.local
# ENT_LDAP_CA_FILE=/etc/ssl/corp-ca.pem
# Служебная учётка только на чтение
ENT_LDAP_BIND_DN=CN=svc-messenger,OU=Service Accounts,DC=example,DC=local
ENT_LDAP_BIND_PASSWORD=
ENT_LDAP_BASE_DN=DC=example,DC=local
# Кто в группе — тому учётка; группа админов даёт роль администратора
ENT_LDAP_GROUP_DN=CN=Messenger Users,OU=Groups,DC=example,DC=local
ENT_LDAP_ADMIN_GROUP_DN=CN=Messenger Admins,OU=Groups,DC=example,DC=local
ENT_DOMAIN=EXAMPLE
ENT_SYNC_INTERVAL_S=60
# Вход: ldap (пароль домена) | radius | ldap+radius (второй фактор)
ENT_AUTH=ldap
ENT_RADIUS_HOST=
ENT_RADIUS_PORT=1812
ENT_RADIUS_SECRET=
# Аварийный локальный администратор (когда домен недоступен): только bcrypt-хеш
ENT_BREAKGLASS_ADMIN=
ENT_BREAKGLASS_HASH=
